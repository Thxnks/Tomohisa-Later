{
	"manifest_version": 3,
	"name": "Tomohisa Information Debt",
	"version": "0.1.0",
	"description": "Save the current page to the local Tomohisa Information Debt API.",
	"permissions": ["activeTab", "storage"],
	"host_permissions": ["http://127.0.0.1/*"],
	"action": {
		"default_title": "Save as Information Debt",
		"default_popup": "popup.html"
	},
	"options_page": "options.html"
}
